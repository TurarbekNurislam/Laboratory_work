class Student:

  def __init__(self, name, age, major):
    self.name = name  
    self.age = age  
    self.major = major  

  def display_info(self):
    """Вывод информации о студенте"""
    print(f"Студент: {self.name}, Возраст: {self.age}, Специальность: {self.major}")

  def change_major(self, new_major):
    """Изменение специальности"""
    self.major = new_major
    print(f"Специальность успешно изменена на: {self.major}")


student1 = Student("Эльдар", 18, "Программная инженерия")
student1.display_info()
student1.change_major("Кибербезопасность")
student1.display_info()

