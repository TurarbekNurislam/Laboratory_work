<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Расчёт стоимости заказа</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
            padding: 30px;
        }

        .container {
            width: 400px;
            margin: auto;
            padding: 25px;
            background-color: white;
            border-radius: 10px;
        }

        input, select, button {
            width: 100%;
            padding: 10px;
            margin-top: 10px;
            box-sizing: border-box;
        }

        button {
            background-color: #2196f3;
            color: white;
            border: none;
            cursor: pointer;
        }

        #result {
            font-size: 20px;
            font-weight: bold;
            margin-top: 20px;
        }
    </style>
</head>

<body>

<div class="container">

    <h1>Расчёт стоимости заказа</h1>

    <label>Цена товара:</label>
    <input type="number" id="price" placeholder="Введите цену">

    <label>Количество:</label>
    <input type="number" id="quantity" placeholder="Введите количество">

    <label>Категория доставки:</label>
    <select id="delivery">
        <option value="standard">Обычная — 500 ₸</option>
        <option value="express">Экспресс — 1000 ₸</option>
        <option value="free">Бесплатная — 0 ₸</option>
    </select>

    <button id="calculate">Рассчитать</button>
    <button id="clear">Очистить</button>

    <p id="result">Итоговая сумма: </p>

    <h3>История заказов:</h3>
    <ul id="history"></ul>

</div>

<script src="script.js"></script>

</body>
</html>

