
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Дашборд задач — Fetch API</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px 16px;
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            color: #1e293b;
        }

        .container {
            max-width: 1000px;
            margin: auto;
        }

        h1 {
            color: #1d4ed8;
            margin-bottom: 8px;
        }

        .subtitle {
            color: #64748b;
            margin-bottom: 24px;
            line-height: 1.5;
        }

        .toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 20px;
        }

        button, select {
            padding: 11px 15px;
            border-radius: 7px;
            font-size: 15px;
        }

        button {
            background: #2563eb;
            color: white;
            border: none;
            cursor: pointer;
        }

        button:hover {
            background: #1d4ed8;
        }

        button:disabled {
            opacity: 0.6;
            cursor: wait;
        }

        select {
            background: white;
            border: 1px solid #cbd5e1;
            min-width: 180px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .card {
            padding: 22px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 3px 10px #0000000a;
            border-top: 4px solid #64748b;
        }

        .card.total {
            border-color: #3b82f6;
        }

        .card.completed {
            border-color: #22c55e;
        }

        .card.pending {
            border-color: #f97316;
        }

        .card h3 {
            margin: 0 0 12px;
            font-size: 15px;
            color: #64748b;
        }

        .number {
            font-size: 32px;
            font-weight: bold;
        }

        #status {
            margin: 16px 0;
            color: #475569;
        }

        .task-list {
            display: grid;
            gap: 12px;
        }

        .task {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 16px;
            border-radius: 9px;
            background: white;
            border-left: 5px solid #f97316;
            overflow-wrap: anywhere;
        }

        .task.done {
            border-left-color: #22c55e;
            background: #f0fdf4;
        }

        .task-info {
            flex: 1;
        }

        .task-title {
            margin: 0 0 8px;
            font-size: 16px;
        }

        .task.done .task-title {
            color: #166534;
        }

        .task-meta {
            font-size: 13px;
            color: #64748b;
        }

        .badge {
            display: inline-block;
            margin-top: 8px;
            padding: 4px 8px;
            border-radius: 20px;
            background: #ffedd5;
            color: #9a3412;
            font-size: 12px;
        }

        .task.done .badge {
            background: #dcfce7;
            color: #166534;
        }

        .empty {
            padding: 24px;
            background: white;
            border-radius: 10px;
            color: #64748b;
            text-align: center;
        }

        footer {
            margin-top: 28px;
            color: #64748b;
            font-size: 13px;
        }

        @media (max-width: 600px) {
            .stats {
                grid-template-columns: 1fr;
            }

            .card {
                padding: 16px;
            }

            .number {
                font-size: 26px;
            }
        }
    </style>
</head>

<body>
    <main class="container">
        <h1>Дашборд задач</h1>

        <p class="subtitle">
            Лабораторная работа №9 — Fetch API / AJAX.
            Статистика задач и фильтрация по пользователям.
        </p>

        <div class="toolbar">
            <button id="loadBtn">Загрузить задачи</button>

            <select id="userFilter" aria-label="Фильтр по пользователю" disabled>
                <option value="all">Все пользователи</option>
            </select>

            <select id="statusFilter" aria-label="Фильтр по статусу" disabled>
                <option value="all">Все задачи</option>
                <option value="completed">Выполненные</option>
                <option value="pending">Невыполненные</option>
            </select>
        </div>

        <section class="stats" aria-label="Статистика задач">
            <div class="card total">
                <h3>Всего задач</h3>
                <div class="number" id="totalCount">0</div>
            </div>

            <div class="card completed">
                <h3>Выполнено</h3>
                <div class="number" id="completedCount">0</div>
            </div>

            <div class="card pending">
                <h3>Не выполнено</h3>
                <div class="number" id="pendingCount">0</div>
            </div>
        </section>

        <p id="status" role="status" aria-live="polite">
            Нажмите «Загрузить задачи», чтобы получить данные.
        </p>

        <section id="taskList" class="task-list"
                 aria-label="Список задач"></section>

        <footer>
            Источник данных:
            JSONPlaceholder — публичный учебный REST API.
        </footer>
    </main>

    <script>
        const loadBtn = document.querySelector("#loadBtn");
        const userFilter = document.querySelector("#userFilter");
        const statusFilter = document.querySelector("#statusFilter");
        const status = document.querySelector("#status");
        const taskList = document.querySelector("#taskList");

        const totalCount = document.querySelector("#totalCount");
        const completedCount = document.querySelector("#completedCount");
        const pendingCount = document.querySelector("#pendingCount");

        // Массив всех загруженных задач
        let todos = [];

        // Загрузка данных с REST API
        loadBtn.addEventListener("click", loadTodos);

        async function loadTodos() {
            loadBtn.disabled = true;
            userFilter.disabled = true;
            statusFilter.disabled = true;

            status.textContent = "Загрузка задач...";
            taskList.replaceChildren();

            try {
                const response = await fetch(
                    "https://jsonplaceholder.typicode.com/todos"
                );

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                todos = await response.json();

                if (!Array.isArray(todos)) {
                    throw new Error("Получен некорректный формат данных");
                }

                fillUserFilter();

                userFilter.value = "all";
                statusFilter.value = "all";

                userFilter.disabled = false;
                statusFilter.disabled = false;

                renderDashboard();

            } catch (error) {
                todos = [];

                updateStatistics([]);
                taskList.replaceChildren();

                status.textContent =
                    `Ошибка загрузки: ${error.message}. ` +
                    "Проверьте подключение к интернету.";

            } finally {
                loadBtn.disabled = false;
            }
        }

        // Создание списка пользователей из загруженных задач
        function fillUserFilter() {
            userFilter.replaceChildren();

            const allOption = document.createElement("option");
            allOption.value = "all";
            allOption.textContent = "Все пользователи";
            userFilter.appendChild(allOption);

            const userIds = [...new Set(
                todos.map(todo => todo.userId)
            )].sort((a, b) => a - b);

            for (const userId of userIds) {
                const option = document.createElement("option");
                option.value = String(userId);
                option.textContent = `Пользователь ${userId}`;
                userFilter.appendChild(option);
            }
        }

        // Обновление при изменении фильтров
        userFilter.addEventListener("change", renderDashboard);
        statusFilter.addEventListener("change", renderDashboard);

        function renderDashboard() {
            const selectedUser = userFilter.value;
            const selectedStatus = statusFilter.value;

            // Сначала отбираем задачи по пользователю
            let filteredTodos = todos.filter(todo => {
                return selectedUser === "all" ||
                    todo.userId === Number(selectedUser);
            });

            // Статистика относится к выбранному пользователю,
            // независимо от фильтра статуса
            updateStatistics(filteredTodos);

            // Затем применяем фильтр по статусу
            filteredTodos = filteredTodos.filter(todo => {
                if (selectedStatus === "completed") {
                    return todo.completed;
                }

                if (selectedStatus === "pending") {
                    return !todo.completed;
                }

                return true;
            });

            renderTasks(filteredTodos);

            status.textContent =
                `Показано задач: ${filteredTodos.length}. ` +
                `Всего после фильтрации по пользователю: ` +
                `${selectedUser === "all" ? todos.length :
                    todos.filter(todo =>
                        todo.userId === Number(selectedUser)
                    ).length}.`;
        }

        // Подсчёт статистики
        function updateStatistics(items) {
            const completed = items.filter(
                todo => todo.completed
            ).length;

            totalCount.textContent = items.length;
            completedCount.textContent = completed;
            pendingCount.textContent = items.length - completed;
        }

        // Отображение задач в DOM
        function renderTasks(items) {
            taskList.replaceChildren();

            if (items.length === 0) {
                const message = document.createElement("div");
                message.className = "empty";
                message.textContent = "Задачи не найдены.";
                taskList.appendChild(message);
                return;
            }

            for (const todo of items) {
                const article = document.createElement("article");
                article.className = "task";

                if (todo.completed) {
                    article.classList.add("done");
                }

                const info = document.createElement("div");
                info.className = "task-info";

                const title = document.createElement("h3");
                title.className = "task-title";
                title.textContent = `${todo.id}. ${todo.title}`;

                const meta = document.createElement("div");
                meta.className = "task-meta";
                meta.textContent = `ID пользователя: ${todo.userId}`;

                const badge = document.createElement("span");
                badge.className = "badge";
                badge.textContent = todo.completed
                    ? "✓ Выполнена"
                    : "○ Не выполнена";

                info.append(title, meta, badge);
                article.appendChild(info);
                taskList.appendChild(article);
            }
        }
    </script>
</body>
</html>

