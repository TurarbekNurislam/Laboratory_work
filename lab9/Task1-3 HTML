
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Лабораторная работа №9 — Fetch API</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            margin: 0;
            padding: 30px 15px;
            color: #1e293b;
        }

        .container {
            max-width: 750px;
            margin: auto;
            padding: 25px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px #00000012;
        }

        h1 {
            color: #1d4ed8;
        }

        button {
            padding: 12px 20px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 7px;
            cursor: pointer;
            font-size: 16px;
        }

        button:hover {
            background: #1d4ed8;
        }

        button:disabled {
            opacity: 0.6;
            cursor: wait;
        }

        #status {
            margin: 20px 0;
            color: #475569;
        }

        #results {
            padding: 0;
            list-style: none;
        }

        #results li {
            padding: 14px;
            margin-bottom: 10px;
            border-radius: 8px;
            line-height: 1.5;
        }

        .completed {
            background: #dcfce7;
            color: #166534;
            border-left: 5px solid #22c55e;
        }

        .pending {
            background: #fff7ed;
            color: #9a3412;
            border-left: 5px solid #f97316;
        }

        .legend {
            margin-top: 20px;
            font-size: 14px;
            color: #475569;
        }

        .footer {
            margin-top: 25px;
            color: #64748b;
            font-size: 13px;
        }
    </style>
</head>

<body>
    <main class="container">
        <h1>Лабораторная работа №9</h1>
        <h2>Асинхронные запросы: Fetch API / AJAX</h2>

        <p>
            Задание №1: загрузить 10 задач из публичного REST API
            и выделить выполненные задачи.
        </p>

        <button id="load">Загрузить задачи</button>

        <p id="status" role="status" aria-live="polite">
            Нажмите кнопку для загрузки задач.
        </p>

        <ul id="results"></ul>

        <div class="legend">
            🟢 Выполненная задача
            <br><br>
            🟠 Невыполненная задача
        </div>

        <div class="footer">
            Дисциплина: «Языки и технология программирования»
        </div>
    </main>

    <script>
        const button = document.querySelector("#load");
        const status = document.querySelector("#status");
        const results = document.querySelector("#results");

        button.addEventListener("click", async () => {
            button.disabled = true;
            status.textContent = "Загрузка задач...";
            results.replaceChildren();

            try {
                const response = await fetch(
                    "https://jsonplaceholder.typicode.com/todos?_limit=10"
                );

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const todos = await response.json();

                let completedCount = 0;

                for (const todo of todos) {
                    const item = document.createElement("li");

                    item.textContent =
                        `${todo.id}. ${todo.title} — ` +
                        (todo.completed
                            ? "Выполнена ✓"
                            : "Не выполнена");

                    if (todo.completed) {
                        item.classList.add("completed");
                        completedCount++;
                    } else {
                        item.classList.add("pending");
                    }

                    results.appendChild(item);
                }

                status.textContent =
                    `Загружено задач: ${todos.length}. ` +
                    `Выполнено: ${completedCount}. ` +
                    `Осталось выполнить: ${todos.length - completedCount}.`;

            } catch (error) {
                status.textContent =
                    `Ошибка загрузки: ${error.message}. ` +
                    "Проверьте подключение к интернету.";

            } finally {
                button.disabled = false;
            }
        });
    </script>
</body>
</html>

