
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Список публикаций — Fetch API</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            color: #1e293b;
            margin: 0;
            padding: 30px 15px;
        }

        .container {
            max-width: 800px;
            margin: auto;
            padding: 25px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px #00000012;
        }

        h1 {
            color: #1d4ed8;
            margin-top: 0;
        }

        .description {
            color: #64748b;
            line-height: 1.5;
        }

        .controls {
            display: flex;
            gap: 10px;
            margin: 20px 0;
            flex-wrap: wrap;
        }

        input {
            flex: 1;
            min-width: 200px;
            padding: 12px;
            border: 1px solid #cbd5e1;
            border-radius: 7px;
            font-size: 16px;
        }

        button {
            padding: 12px 18px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 7px;
            cursor: pointer;
            font-size: 15px;
        }

        button:hover {
            background: #1d4ed8;
        }

        button:disabled {
            opacity: 0.6;
            cursor: wait;
        }

        #status {
            color: #475569;
            margin: 15px 0;
        }

        .post {
            padding: 18px;
            margin-bottom: 14px;
            border: 1px solid #e2e8f0;
            border-radius: 9px;
            background: #f8fafc;
        }

        .post h3 {
            color: #1d4ed8;
            margin: 0 0 10px;
            text-transform: capitalize;
        }

        .post p {
            line-height: 1.6;
            margin-bottom: 0;
        }

        .post-id {
            color: #64748b;
            font-size: 13px;
            margin-bottom: 8px;
        }

        .empty {
            padding: 20px;
            text-align: center;
            color: #b91c1c;
            background: #fef2f2;
            border-radius: 8px;
        }

        .footer {
            margin-top: 25px;
            font-size: 13px;
            color: #64748b;
        }
    </style>
</head>

<body>
    <main class="container">
        <h1>Список публикаций</h1>

        <p class="description">
            Лабораторная работа №9 — асинхронные запросы
            (Fetch API / AJAX). Загрузите публикации и найдите
            нужную по заголовку.
        </p>

        <div class="controls">
            <button id="loadBtn">Загрузить публикации</button>
            <input
                type="search"
                id="searchInput"
                placeholder="Поиск по заголовку..."
                aria-label="Поиск публикаций по заголовку"
                disabled
            >
        </div>

        <p id="status" role="status" aria-live="polite">
            Нажмите кнопку, чтобы загрузить публикации.
        </p>

        <div id="results"></div>

        <div class="footer">
            Данные предоставлены учебным API JSONPlaceholder.
        </div>
    </main>

    <script>
        const loadBtn = document.querySelector("#loadBtn");
        const searchInput = document.querySelector("#searchInput");
        const status = document.querySelector("#status");
        const results = document.querySelector("#results");

        // Храним загруженные публикации в памяти браузера
        let posts = [];

        // Загрузка публикаций
        loadBtn.addEventListener("click", async () => {
            loadBtn.disabled = true;
            searchInput.disabled = true;
            status.textContent = "Загрузка публикаций...";
            results.replaceChildren();

            try {
                const response = await fetch(
                    "https://jsonplaceholder.typicode.com/posts"
                );

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                posts = await response.json();

                searchInput.disabled = false;
                searchInput.value = "";

                renderPosts(posts);

                status.textContent =
                    `Загружено публикаций: ${posts.length}.`;

            } catch (error) {
                posts = [];

                status.textContent =
                    `Ошибка загрузки: ${error.message}. ` +
                    "Проверьте подключение к интернету.";

            } finally {
                loadBtn.disabled = false;
            }
        });

        // Поиск выполняется на клиенте по уже загруженным данным
        searchInput.addEventListener("input", () => {
            const query = searchInput.value
                .trim()
                .toLowerCase();

            const filteredPosts = posts.filter(post =>
                post.title.toLowerCase().includes(query)
            );

            renderPosts(filteredPosts);

            status.textContent =
                `Найдено публикаций: ${filteredPosts.length} ` +
                `из ${posts.length}.`;
        });

        // Отображение публикаций на странице
        function renderPosts(postsToShow) {
            results.replaceChildren();

            if (postsToShow.length === 0) {
                const message = document.createElement("div");
                message.className = "empty";
                message.textContent = "Публикации не найдены.";
                results.appendChild(message);
                return;
            }

            for (const post of postsToShow) {
                const article = document.createElement("article");
                article.className = "post";

                const id = document.createElement("div");
                id.className = "post-id";
                id.textContent = `Публикация №${post.id}`;

                const title = document.createElement("h3");
                title.textContent = post.title;

                const body = document.createElement("p");
                body.textContent = post.body;

                article.append(id, title, body);
                results.appendChild(article);
            }
        }
    </script>
</body>
</html>

