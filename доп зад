
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Лабораторная работа №12 — Дополнительное задание</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #141e30, #243b55);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
}

.container {
    width: 90%;
    max-width: 500px;
    background: white;
    padding: 35px;
    border-radius: 18px;
    text-align: center;
    box-shadow: 0 10px 40px #0005;
}

h1 {
    color: #243b55;
}

input {
    width: 100%;
    padding: 13px;
    margin: 10px 0;
    border: 1px solid #ccc;
    border-radius: 8px;
}

button {
    width: 100%;
    padding: 13px;
    margin: 8px 0;
    border: none;
    border-radius: 8px;
    background: #24558a;
    color: white;
    cursor: pointer;
    font-size: 15px;
}

button:hover {
    background: #163c68;
}

.logout {
    background: #d93636;
}

.timer {
    background: #edf2f8;
    padding: 20px;
    border-radius: 12px;
    margin: 20px 0;
}

#time {
    font-size: 35px;
    font-weight: bold;
    color: #24558a;
}

.warning {
    color: #d93636;
    font-weight: bold;
}

#message {
    margin-top: 15px;
}

[hidden] {
    display: none !important;
}
</style>
</head>

<body>

<div class="container">

    <h1>⏱ Управление сессией</h1>
    <p>Дополнительное задание №4</p>

    <div id="loginPanel">

        <h3>Вход в аккаунт</h3>

        <input id="login" placeholder="Логин">
        <input id="password" type="password"
               placeholder="Пароль">

        <button onclick="login()">Войти</button>

        <p>Логин: student</p>
        <p>Пароль: student123</p>

    </div>

    <div id="profilePanel" hidden>

        <h2>Добро пожаловать!</h2>

        <p>Вы успешно вошли в систему.</p>

        <div class="timer">

            <p>Осталось времени сессии:</p>

            <div id="time">02:00</div>

            <p id="warning"></p>

        </div>

        <button onclick="extendSession()">
            Продлить сессию
        </button>

        <button class="logout" onclick="logout()">
            Выйти из аккаунта
        </button>

    </div>

    <div id="message"></div>

</div>

<script>

const USER_LOGIN = "student";
const USER_PASSWORD = "student123";

const SESSION_DURATION = 120;

let remainingTime = SESSION_DURATION;
let timer = null;
let isLoggedIn = false;

// Авторизация
function login() {

    const loginValue =
        document.getElementById("login").value;

    const passwordValue =
        document.getElementById("password").value;

    if (
        loginValue !== USER_LOGIN ||
        passwordValue !== USER_PASSWORD
    ) {
        show("❌ Неверный логин или пароль!");
        return;
    }

    isLoggedIn = true;

    document.getElementById("loginPanel").hidden = true;
    document.getElementById("profilePanel").hidden = false;

    show("✅ Вы успешно вошли в систему!");

    startTimer();
}

// Запуск таймера
function startTimer() {

    clearInterval(timer);

    remainingTime = SESSION_DURATION;

    updateTimer();

    timer = setInterval(() => {

        if (!isLoggedIn) {
            clearInterval(timer);
            return;
        }

        remainingTime--;

        updateTimer();

        if (remainingTime <= 0) {

            clearInterval(timer);

            alert("Время сессии истекло!");

            logout();

            show("⏰ Сессия завершена автоматически.");
        }

    }, 1000);
}

// Обновление времени
function updateTimer() {

    const minutes = Math.floor(remainingTime / 60);
    const seconds = remainingTime % 60;

    document.getElementById("time").textContent =
        String(minutes).padStart(2, "0") + ":" +
        String(seconds).padStart(2, "0");

    if (remainingTime <= 30) {

        document.getElementById("warning").textContent =
            "⚠ Внимание! Скоро сессия завершится.";

        document.getElementById("time").style.color = "#d93636";

    } else {

        document.getElementById("warning").textContent = "";

        document.getElementById("time").style.color = "#24558a";
    }
}

// Продление сессии
function extendSession() {

    if (!isLoggedIn) return;

    startTimer();

    show("✅ Время сессии продлено на 2 минуты.");
}

// Выход
function logout() {

    isLoggedIn = false;

    clearInterval(timer);

    document.getElementById("loginPanel").hidden = false;
    document.getElementById("profilePanel").hidden = true;

    document.getElementById("login").value = "";
    document.getElementById("password").value = "";

    remainingTime = SESSION_DURATION;

    show("Вы вышли из аккаунта.");
}

// Сообщения
function show(text) {

    document.getElementById("message").textContent = text;

}

</script>

</body>
</html>
