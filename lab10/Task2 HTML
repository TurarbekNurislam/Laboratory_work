
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Список задач</title>
<style>
body {
    font-family: Arial;
    background: #e0f2fe;
    padding: 30px;
}
.container {
    max-width: 550px;
    margin: 40px auto;
    background: white;
    padding: 25px;
    border-radius: 12px;
}
h1 { text-align: center; color: #0369a1; }
input {
    width: 65%;
    padding: 12px;
    box-sizing: border-box;
}
button {
    padding: 12px;
    background: #0284c7;
    color: white;
    border: none;
    cursor: pointer;
    border-radius: 5px;
}
li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px;
    margin: 10px 0;
    background: #f0f9ff;
}
li span { flex: 1; overflow-wrap: anywhere; }
.completed {
    text-decoration: line-through;
    color: gray;
}
.delete { background: #dc2626; }
</style>
</head>
<body>

<div class="container">
<h1>Мои задачи</h1>

<input id="taskInput" placeholder="Введите задачу">
<button id="addTask">Добавить</button>

<p id="counter">Всего задач: 0</p>
<ul id="taskList"></ul>
</div>

<script type="module">
// Модуль хранения
const Storage = {
    save(tasks) {
        localStorage.setItem("tasks", JSON.stringify(tasks));
    },
    load() {
        try {
            const data = JSON.parse(localStorage.getItem("tasks") || "[]");
            if (!Array.isArray(data)) return [];
            return data.filter(task =>
                task &&
                Number.isFinite(task.id) &&
                typeof task.title === "string" &&
                typeof task.completed === "boolean"
            );
        } catch {
            return [];
        }
    }
};

// Модуль управления задачами
const Tasks = {
    add(tasks, title) {
        if (!title.trim()) throw new Error("Введите задачу!");

        return [...tasks, {
            id: Date.now() + Math.random(),
            title: title.trim(),
            completed: false
        }];
    },

    remove(tasks, id) {
        return tasks.filter(task => task.id !== id);
    },

    toggle(tasks, id) {
        return tasks.map(task =>
            task.id === id
                ? {...task, completed: !task.completed}
                : task
        );
    }
};

// Модуль интерфейса
const UI = {
    render(tasks) {
        const list = document.querySelector("#taskList");
        list.replaceChildren();

        tasks.forEach(task => {
            const li = document.createElement("li");
            const title = document.createElement("span");
            title.textContent = task.title;

            if (task.completed) title.classList.add("completed");

            const done = document.createElement("button");
            done.textContent = task.completed ? "Вернуть" : "Готово";
            done.dataset.action = "toggle";
            done.dataset.id = task.id;

            const remove = document.createElement("button");
            remove.textContent = "Удалить";
            remove.className = "delete";
            remove.dataset.action = "remove";
            remove.dataset.id = task.id;

            li.append(title, done, remove);
            list.append(li);
        });

        const completed = tasks.filter(t => t.completed).length;
        document.querySelector("#counter").textContent =
            `Всего: ${tasks.length} | Выполнено: ${completed} | Осталось: ${tasks.length - completed}`;
    }
};

// Главный модуль
let tasks = Storage.load();

function update() {
    UI.render(tasks);
    Storage.save(tasks);
}

document.querySelector("#addTask").addEventListener("click", () => {
    try {
        tasks = Tasks.add(tasks, document.querySelector("#taskInput").value);
        document.querySelector("#taskInput").value = "";
        update();
    } catch(error) {
        alert(error.message);
    }
});

document.querySelector("#taskInput").addEventListener("keydown", event => {
    if (event.key === "Enter") {
        document.querySelector("#addTask").click();
    }
});

document.querySelector("#taskList").addEventListener("click", event => {
    const button = event.target.closest("button[data-action]");
    if (!button) return;

    const id = Number(button.dataset.id);

    if (button.dataset.action === "toggle")
        tasks = Tasks.toggle(tasks, id);

    if (button.dataset.action === "remove")
        tasks = Tasks.remove(tasks, id);

    update();
});

update();
</script>

</body>
</html>
