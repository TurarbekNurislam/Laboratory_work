
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Мини-CRM клиентов</title>
<style>
body {
    font-family: Arial;
    background: #f1f5f9;
    padding: 25px;
}
.container {
    max-width: 650px;
    margin: 30px auto;
    padding: 25px;
    background: white;
    border-radius: 12px;
}
h1 { text-align: center; color: #4338ca; }
input {
    width: 100%;
    box-sizing: border-box;
    padding: 12px;
    margin: 8px 0;
    border: 1px solid #ccc;
    border-radius: 6px;
}
button {
    padding: 10px 15px;
    margin: 5px;
    background: #4f46e5;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}
.delete { background: #dc2626; }
.client {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 12px;
    margin-top: 10px;
    background: #eef2ff;
    border-radius: 8px;
}
#message { color: #4338ca; font-weight: bold; }
</style>
</head>
<body>

<div class="container">
<h1>Мини-CRM клиентов</h1>

<form id="clientForm">
<input type="hidden" id="clientId">
<input id="name" placeholder="Имя клиента">
<input id="phone" placeholder="Номер телефона">
<button type="submit" id="saveButton">Добавить клиента</button>
</form>

<input id="search" placeholder="Поиск по имени или телефону">

<p id="message" aria-live="polite"></p>
<div id="clientsList"></div>
</div>

<script type="module">
// Модуль проверки данных
const Validation = {
    check(name, phone) {
        if (!name.trim() || !phone.trim())
            return "Заполните все поля!";

        if (name.trim().length < 2)
            return "Имя должно содержать минимум 2 символа!";

        const clean = phone.replace(/[\s()+-]/g, "");

        if (!/^\d{7,15}$/.test(clean))
            return "Неверный номер телефона!";

        return null;
    }
};

// Модуль работы с клиентами
const Clients = {
    add(clients, name, phone) {
        return [...clients, {
            id: Date.now(),
            name: name.trim(),
            phone: phone.trim()
        }];
    },

    edit(clients, id, name, phone) {
        return clients.map(client =>
            client.id === id
                ? {...client, name: name.trim(), phone: phone.trim()}
                : client
        );
    },

    remove(clients, id) {
        return clients.filter(client => client.id !== id);
    }
};

// Модуль поиска
const Search = {
    find(clients, query) {
        const text = query.trim().toLowerCase();

        if (!text) return clients;

        return clients.filter(client =>
            client.name.toLowerCase().includes(text) ||
            client.phone.toLowerCase().includes(text)
        );
    }
};

// Модуль хранения
const Storage = {
    save(clients) {
        localStorage.setItem("crm_clients", JSON.stringify(clients));
    },

    load() {
        try {
            const data = JSON.parse(localStorage.getItem("crm_clients") || "[]");

            if (!Array.isArray(data)) return [];

            return data.filter(client =>
                client &&
                Number.isSafeInteger(client.id) &&
                typeof client.name === "string" &&
                typeof client.phone === "string"
            );
        } catch {
            return [];
        }
    }
};

// Модуль интерфейса
const UI = {
    render(clients) {
        const container = document.querySelector("#clientsList");
        container.replaceChildren();

        if (!clients.length) {
            container.textContent = "Клиенты не найдены";
            return;
        }

        clients.forEach(client => {
            const card = document.createElement("div");
            card.className = "client";

            const info = document.createElement("div");
            const name = document.createElement("strong");
            name.textContent = client.name;

            const phone = document.createElement("p");
            phone.textContent = client.phone;

            info.append(name, phone);

            const edit = document.createElement("button");
            edit.textContent = "Изменить";
            edit.dataset.action = "edit";
            edit.dataset.id = client.id;

            const remove = document.createElement("button");
            remove.textContent = "Удалить";
            remove.className = "delete";
            remove.dataset.action = "delete";
            remove.dataset.id = client.id;

            card.append(info, edit, remove);
            container.append(card);
        });
    }
};

// Главный модуль
let clients = Storage.load();

const form = document.querySelector("#clientForm");
const nameInput = document.querySelector("#name");
const phoneInput = document.querySelector("#phone");
const idInput = document.querySelector("#clientId");
const searchInput = document.querySelector("#search");
const message = document.querySelector("#message");
const saveButton = document.querySelector("#saveButton");
const list = document.querySelector("#clientsList");

function update() {
    Storage.save(clients);
    UI.render(Search.find(clients, searchInput.value));
}

function clearForm() {
    form.reset();
    idInput.value = "";
    saveButton.textContent = "Добавить клиента";
}

form.addEventListener("submit", event => {
    event.preventDefault();

    const name = nameInput.value;
    const phone = phoneInput.value;
    const error = Validation.check(name, phone);

    if (error) {
        message.textContent = error;
        return;
    }

    if (idInput.value) {
        clients = Clients.edit(clients, Number(idInput.value), name, phone);
        message.textContent = "Клиент обновлён!";
    } else {
        clients = Clients.add(clients, name, phone);
        message.textContent = "Клиент добавлен!";
    }

    clearForm();
    update();
});

searchInput.addEventListener("input", update);

list.addEventListener("click", event => {
    const button = event.target.closest("button[data-action]");
    if (!button) return;

    const id = Number(button.dataset.id);
    const client = clients.find(item => item.id === id);

    if (!client) return;

    if (button.dataset.action === "delete") {
        clients = Clients.remove(clients, id);
        message.textContent = "Клиент удалён!";

        if (idInput.value === String(id)) clearForm();
    }

    if (button.dataset.action === "edit") {
        idInput.value = client.id;
        nameInput.value = client.name;
        phoneInput.value = client.phone;
        saveButton.textContent = "Сохранить изменения";
        message.textContent = "Редактирование клиента";
    }

    update();
});

update();
</script>

</body>
</html>
